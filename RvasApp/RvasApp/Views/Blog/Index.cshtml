@model IEnumerable<RvasApp.Models.Post>
@{
    ViewData["Title"] = "Blog";
}

<div class="container px-0">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h3 mb-0">Sve objave</h1>
            <div class="text-muted small">Svi postovi na blogu</div>
        </div>
        <a class="btn btn-success" asp-action="Objavi">Kreiraj novi post</a>
    </div>


    <form method="get" class="mb-4">
        @* pretraga *@
        <div class="mb-2">
            <input type="text"
                name="pretraga"
                value="@ViewBag.TrenutnaPretraga"
                class="form-control"
                placeholder="Pretraga po naslovu"/>
        </div>

        @* filtranje *@
        <div class="mb-2">
            <select name="kategorija"
                asp-items="ViewBag.Kategorije"
                class="form-select">
                <option value="">Sve kategorije</option>
            </select>
        </div>

        @* sortiranje *@
        <div class="mb-2">
            <select name="sort" class="form-select">

                <option value="">Naziv ASC</option>

                <option value="naziv_desc"
                        selected="@(ViewBag.TrenutniSort == "naslov_desc")">
                    Naziv DESC
                </option>

                <option value="datum_asc"
                        selected="@(ViewBag.TrenutniSort == "datum_asc")">
                    Datum ASC
                </option>

                <option value="datum_desc"
                        selected="@(ViewBag.TrenutniSort == "datum_desc")">
                    Datum DESC
                </option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Primeni
        </button>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-secondary mb-0" role="alert">
            Trenutno nema postova
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var p in Model)
            {
                <div class="list-group-item p-0 border-0 mb-2">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <div class="min-w-0">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <a class="h5 mb-1 text-decoration-none text-body"
                                               asp-action="Objava"
                                               asp-route-id="@p.PostId">
                                            @p.Naslov
                                        </a>
                                    </div>

                                    <div class="text-muted small">
                                        <span class="me-2">
                                            <span class="fw-semibold">Autor:</span> @p.Korisnik.KorisnickoIme
                                        </span>
                                        <span class="me-2">·</span>
                                        <span>
                                            <span class="fw-semibold">Kreirano:</span> @p.DatumKreiranja.ToString("dd.MM.yyyy")
                                        </span>
                                    </div>
                                    @* nekategorizovano kada nema kategoriju! *@
                                    <div class="text-muted small">
                                        <span class="me-2">
                                            <span class="fw-semibold">Kategorija:</span> @(p.Kategorija?.Naziv ?? "Nekategorizovano")
                                        </span>
                                    </div>
                                </div>

                                <div class="flex-shrink-0">
                                    <a asp-action="Objava"
                                           asp-route-id="@p.PostId"
                                           class="btn btn-outline-warning">
                                        Opsirnije
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
