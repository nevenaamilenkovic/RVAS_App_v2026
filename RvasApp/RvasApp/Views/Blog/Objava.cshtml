@model RvasApp.Models.Post
@using RvasApp.Models.ViewModels
@{
    ViewData["Title"] = $"{Model.Naslov}";
    //prikaz pozitivnih/negativnih
    var glas = ViewBag.Glas as PostVoteViewModel ?? new PostVoteViewModel { PostId = Model.PostId };
}

@if (Model == null)
{
    <div class="container px-0">
        <div class="alert alert-warning" role="alert">
            Objava nije pronadjena
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Nazad na listu</a>
    </div>
}
else
{
    <div class="container px-0">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div class="min-w-0">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Nazad</a>
                    <span class="text-muted small">Blog / @Model.Naslov</span>
                </div>
                <h1 class="h3 mb-1 text-break">@Model.Naslov</h1>
                <div class="text-muted small">
                    <span class="me-2">
                        <span class="fw-semibold">Autor:</span> @(Model.Korisnik?.KorisnickoIme ?? "Nepoznato")
                    </span>
                    <span class="me-2">·</span>
                    <span>
                        <span class="fw-semibold">Kreirano:</span> @Model.DatumKreiranja.ToString("dd.MM.yyyy")
                    </span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Sve objave</a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3">
                    <div class="flex-shrink-0 d-none d-sm-block">
                        <div class="rounded-circle bg-body-secondary border d-flex align-items-center justify-content-center"
                             style="width:44px;height:44px;">
                            <span class="fw-semibold text-muted">
                                @((Model.Korisnik?.KorisnickoIme ?? "U").Substring(0, 1).ToUpperInvariant())
                            </span>
                        </div>
                    </div>

                    <div class="flex-grow-1">
                        <div class="mb-2 text-muted small">
                            @(Model.Korisnik?.KorisnickoIme ?? "Nepoznato")
                            <span class="mx-2">·</span>
                            @Model.DatumKreiranja.ToString("dd.MM.yyyy")
                        </div>

                        <div class="fs-6" style="white-space: pre-wrap;">
                            @Model.Sadrzaj
                        </div>
                        @* opcije zaa glasanje *@
                        <div class="mt-3">
                            <partial name="_PostGlasovi" model="glas" />
                        </div>
                    </div>
                </div>
            </div>
        </div>


        @* komentari *@
        <h2 class="h5 mt-4">Komentari (@(Model.Komentari?.Count ?? 0))</h2>

        @if (TempData["KomentarGreska"] != null)
        {
            <div class="alert alert-warning" role="alert">
                @TempData["KomentarGreska"]
            </div>
        }

        <form asp-action="DodajKomentar" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="postId" value="@Model.PostId" />

            <div class="mb-2">
                <label for="komentarSadrzaj" class="form-label">Dodaj komentar</label>
                <textarea id="komentarSadrzaj"
                          name="sadrzaj"
                          class="form-control"
                          rows="3"
                          placeholder="Napisi komentar..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Posalji</button>
        </form>

        @{
            ViewData["Dubina"] = 0;
            //ssamo jedan nivo odgovora (na glavni komentar)
            ViewData["MaxDubina"] = 1;
        }
        <partial name="_Komentari" model="Model.Komentari" />
    </div>
}